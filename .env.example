# Copy to .env for local use. Never commit .env or real credentials.
# Current route uses the authenticated stage-2 profile; stage1-stub is retired and appears only in historical records.
SPRING_PROFILES_ACTIVE=stage2-auth
JAVA_SERVER_PORT=8080
# Compose publishes only Nginx on 127.0.0.1; change this in the untracked .env if host port 8080 is occupied.
NGINX_HOST_PORT=8080
AI_SERVICE_BASE_URL=http://127.0.0.1:8000
INTERNAL_TOKEN=

# Stage 2 authentication placeholders. Keep every secret empty in the repository.
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=1800
REFRESH_TOKEN_TTL_SECONDS=604800
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Lax
REFRESH_COOKIE_PATH=/api/auth
AUTH_ENVIRONMENT=development
AUTH_CAPTCHA_MODE=console
AUTH_CAPTCHA_TTL_SECONDS=300
AUTH_SMS_PROVIDER=
AUTH_PUBLIC_REGISTRATION_ENABLED=true
# Compose sets required mode to true; the historical manual bootstrap profile defaults to false.
AUTH_BOOTSTRAP_REQUIRED=false
DEMO_USERNAME=
DEMO_PASSWORD=
ADMIN_USERNAME=
ADMIN_PASSWORD=

LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSION=512
MODEL_CACHE_DIR=./model-cache
VECTOR_STORE_PERSIST_DIR=./faiss_index
VECTOR_STORE_COLLECTION_NAME=doctrail_collection
VECTOR_STORE_BACKEND=faiss
# Stage 8 is optional and not scheduled; keep Qdrant settings empty on the main route.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PREFER_GRPC=false
QDRANT_CONNECT_TIMEOUT_SECONDS=5
QDRANT_READ_TIMEOUT_SECONDS=30
# Stage 5 uses vector-only FAISS retrieval; enable reranking only if stage 8 is separately authorized.
RERANKER_TYPE=disabled

UPLOAD_ROOT=./uploads
# stage2-auth requires STORAGE_BACKEND=local or STORAGE_BACKEND=oss explicitly.
UPLOAD_MAX_FILE_SIZE_MB=20
UPLOAD_MAX_REQUEST_SIZE_MB=25
STORAGE_BACKEND=local
OSS_BUCKET=
OSS_ENDPOINT=
OSS_REGION=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_KEY_PREFIX=doctrail
OSS_PRESIGN_TTL_SECONDS=300
OSS_CONNECT_TIMEOUT=10s
OSS_READ_TIMEOUT=60s
OSS_MAX_RETRIES=3
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=doctrail
MYSQL_USERNAME=doctrail
# Compose requires separate non-empty application and root passwords. Keep real values only in .env.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_CONNECT_TIMEOUT_SECONDS=10
KNOWLEDGE_CHUNK_SIZE=800
KNOWLEDGE_CHUNK_OVERLAP=120
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Compose enables Redis requirepass and reuses this value for its authenticated healthcheck.
REDIS_PASSWORD=

API_HOST=127.0.0.1
API_PORT=8000
PYTHON_READY_TIMEOUT_SECONDS=600
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_READ_TIMEOUT_SECONDS=90
MESSAGE_REQUEST_RUNNING_TIMEOUT_SECONDS=900
MESSAGE_REQUEST_RECOVERY_SCAN_INTERVAL_SECONDS=60
DOC_EXECUTOR_CORE_SIZE=2
DOC_EXECUTOR_QUEUE_CAPACITY=20
LOG_LEVEL=INFO
