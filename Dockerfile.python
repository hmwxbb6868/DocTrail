FROM python:3.11.18-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Keep the large CPU wheel cached when only small dependencies change.
RUN python -m pip install --no-deps \
        --index-url https://download.pytorch.org/whl/cpu \
        torch==2.14.0+cpu

COPY python-service/requirements.txt /tmp/requirements.txt

RUN python -m pip install --requirement /tmp/requirements.txt \
    && python -c "import importlib.metadata as m; forbidden=('nvidia-','cuda-','triton'); names={d.metadata['Name'].lower() for d in m.distributions()}; bad=sorted(n for n in names if n.startswith(forbidden)); assert not bad, f'GPU packages found: {bad}'" \
    && rm -f /tmp/requirements.txt

RUN groupadd --gid 10001 doctrail \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin doctrail \
    && mkdir -p /data/uploads /data/faiss /data/model-cache \
    && chown -R 10001:10001 /app /data/uploads /data/faiss

COPY --chown=10001:10001 python-service/ /app/

USER 10001:10001

CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
